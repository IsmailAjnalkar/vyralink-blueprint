# Copy to .env for docker compose. Never commit .env.
POSTGRES_PASSWORD=change-me
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
APP_SECRET=change-me-to-a-long-random-value
# Optional: creates a platform super admin on first start (must enroll two-step verification at first sign-in).
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEB_URL=http://localhost:3030
WEB_PORT=3030
# Production: your domain (Caddy gets a TLS certificate), WEB_URL=https://<domain>, WEB_ORIGINS=https://<domain>, COOKIE_SECURE=true
SITE_ADDRESS=:80
WEB_ORIGINS=
COOKIE_SECURE=false
WEB_TRUSTED_PROXY_HOPS=0
ORDERS_PROVIDER=csv
HTTPS_PORT=8443
